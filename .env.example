# AutoTrading config — loaded by autotrade_cli.py from ~/.hermes/.env too
# All values can also be set as env vars of the same name.

TRADINGAGENTS_WATCHLIST=NVDA,AAPL
TRADINGAGENTS_IMSG_TO=+15615123130

# Token budget: 100M/week with alerts at 50/75/90%
TRADINGAGENTS_WEEKLY_TOKEN_CAP=100000000

# Research depth (easy control):
TRADINGAGENTS_ANALYSTS=market,news,fundamentals   # add "social" for the 4th analyst
TRADINGAGENTS_DEBATE_ROUNDS=1                     # 1=light, 2+=deeper (more tokens)
TRADINGAGENTS_RISK_ROUNDS=1

# Cost controls
TRADINGAGENTS_RESEARCH_TTL_HOURS=20               # decision cache: re-runs within window are free
TRADINGAGENTS_DEEP_THINK_LLM=glm-4.7
TRADINGAGENTS_QUICK_THINK_LLM=glm-5.3-flash

# Execution: DRY_RUN=1 is log-only. Live money needs DRY_RUN=0 AND ALPACA_LIVE=1.
TRADINGAGENTS_DRY_RUN=1
TRADINGAGENTS_ALPACA_LIVE=0
TRADINGAGENTS_MAX_POSITION_PCT=0.10               # max 10% of equity per symbol

# Screener: algorithmic scan (S&P 500) finds movers; top N get deep-researched
# ONCE each, traded once if directional, then held until stopped out or a
# Monday Sell-check closes them. Never joins the recurring watchlist.
TRADINGAGENTS_SCREENER=1
TRADINGAGENTS_SCREENER_TOP_N=2                    # max new picks per day
